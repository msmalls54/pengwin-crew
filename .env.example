# Local demo defaults to simulated payment and deterministic planning.
DATABASE_URL=sqlite:///./crew.db
POSTGRES_PASSWORD=replace-with-a-long-random-value
SSH_DIR=/home/crew/.ssh
COMPANY_NAME=Pengwin
PAYMENT_MODE=simulated
PLANNER_MODE=deterministic
SANDBOX_MODE=local
ADMIN_TOKEN=replace-with-a-long-random-value
WEB_DEMO_TOKEN=replace-with-a-separate-long-random-value
FREEZE=false

# Live inference: planner_mode=vultr, then set both values.
VULTR_INFERENCE_KEY=
VULTR_MODEL=
VULTR_MAX_CALLS=1000

# Airwallex sandbox only: payment_mode=airwallex_sandbox.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_SANDBOX_BASE=https://api.sandbox.airwallex.com
AW_BENEFICIARY_KAFFEE=
AW_BENEFICIARY_DRUCKWERK=
AW_BENEFICIARY_BAY_SUPPLY=

# Read-only Printful reference quote. A catalog blank is not a finished branded hoodie.
PRINTFUL_TOKEN=
PRINTFUL_HOODIE_VARIANT_ID=
PRINTFUL_STORE_ID=

# Four conversational bots in one private demo channel. Only Concierge owns /crew.
SLACK_CONCIERGE_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_BUYER_BOT_TOKEN=
SLACK_BUYER_APP_TOKEN=
SLACK_EVENTS_BOT_TOKEN=
SLACK_EVENTS_APP_TOKEN=
SLACK_TREASURER_BOT_TOKEN=
SLACK_TREASURER_APP_TOKEN=
SLACK_DEMO_CHANNEL_ID=
SLACK_ALLOWED_USER_IDS=
SLACK_ADMIN_USER_IDS=
SLACK_REPORT_TIMEZONE=America/Los_Angeles

# Luma Plus calendar: never put this full-access calendar key in a sandbox.
# Luma publishing stays disabled without a Plus calendar key.
LUMA_ENABLED=false
LUMA_API_KEY=
# Public RSVP events on Eventbrite. Keep the private token only in Events worker.
EVENTBRITE_ENABLED=false
EVENTBRITE_PRIVATE_TOKEN=
EVENTBRITE_ORGANIZATION_ID=
EVENTBRITE_VENUE_ID=
EVENTBRITE_VENUE_LABEL=

# Remote Docker host on VM 2; do not put these in a sandbox container.
DOCKER_HOST=
SANDBOX_IMAGE=office-ops-sandbox:latest
SANDBOX_NETWORK=shopnet
MOCK_STORE_URL=http://mock-stores:8080
